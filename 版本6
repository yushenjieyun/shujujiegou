struct Node{
    char data[100];
    char type[20];
    struct Node *next;
};

struct Favorite{
    char data[100];
    char type[20];
};

void toLower(char *s){
    int i;
    for(i=0; s[i]!='\0'; i++){
        s[i] = tolower(s[i]);
    }
}

struct Node* searchByKey(char key[], char f1List[][100], int n)
{
    struct Node *head = NULL, *tail = NULL;
    char keyLower[100];
    strcpy(keyLower, key);
    toLower(keyLower);

    int i;
    for(i=0; i<n; i++){
        char temp[100];
        strcpy(temp, f1List[i*2]);
        toLower(temp);

        if(strstr(temp, keyLower) != NULL){
            struct Node *newNode = (struct Node*)malloc(sizeof(struct Node));
            if(newNode == NULL){
                printf("内存分配失败！\n");
                return head;
            }
            strcpy(newNode->data, f1List[i*2]);
            strcpy(newNode->type, f1List[i*2 + 1]);
            newNode->next = NULL;

            if(head == NULL){
                head = newNode;
                tail = newNode;
            }else{
                tail->next = newNode;
                tail = newNode;
            }
        }
    }
    return head;
}

void freeLink(struct Node *h)
{
    struct Node *p=h, *del;
    while(p){
        del=p;
        p=p->next;
        free(del);
    }
}

