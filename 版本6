void showResultWithNumber(struct Node *head){
    struct Node *p = head;
    int num = 1;
    if(p == NULL){
        printf("暂无搜索结果\n");
    }else{
        while(p != NULL){
            printf("%d. [%s] %s\n", num++, p->type, p->data);
            p = p->next;
        }
    }
}

void showResult(struct Node *head){
    struct Node *p = head;
    int count = 0;
    if(p == NULL){
        printf("未找到相关 F1 信息\n");
    }else{
        while(p != NULL){
            printf("[%s] %s\n", p->type, p->data);
            p = p->next;
            count++;
        }
        printf("共找到 %d 条结果\n", count);
    }
}

void getCurrentTime(char *timeStr, int size){
    time_t rawtime;
    struct tm *timeinfo;
    time(&rawtime);
    timeinfo = localtime(&rawtime);
    strftime(timeStr, size, "%Y-%m-%d %H:%M:%S", timeinfo);
}

void exportResult(struct Node *head, char keyword[], struct Favorite favorites[], int favCount){
    if(head == NULL){
        printf("\n暂无搜索结果可导出！请先进行F1关键词搜索。\n");
        return;
    }
    char filename[100];
	    printf("\n===== F6 导出搜索结果 =====\n");
	    printf("请输入导出文件名（不含扩展名，直接回车使用默认名 f1_result）：");
	    fgets(filename, sizeof(filename), stdin);
	    filename[strcspn(filename, "\n")] = '\0';
	    
	    if(strlen(filename) == 0){
	        strcpy(filename, "f1_result");
	    }
	    
	    char fullFilename[150];
	    sprintf(fullFilename, "%s.txt", filename);
	    
	    FILE *fp = fopen(fullFilename, "w");
	    if(fp == NULL){
	        printf("创建文件失败！请检查权限或路径。\n");
	        return;
	    }
	    
	    char timeStr[50];
	    getCurrentTime(timeStr, sizeof(timeStr));
	    
	    fprintf(fp, "========================================\n");
	    fprintf(fp, "       F1 搜索结果导出报告\n");
	    fprintf(fp, "========================================\n");
	    fprintf(fp, "导出时间：%s\n", timeStr);
	    fprintf(fp, "搜索关键词：%s\n", keyword[0] != '\0' ? keyword : "（未指定）");
	    fprintf(fp, "----------------------------------------\n\n");
	    
	    struct Node *p = head;
	    int count = 0;
	    fprintf(fp, "【搜索结果】\n");
	    while(p != NULL){
	        fprintf(fp, "  %d. [%s] %s\n", ++count, p->type, p->data);
	        p = p->next;
	    }
	    fprintf(fp, "\n共找到 %d 条结果\n\n", count);
	    
	    if(favCount > 0){
	        fprintf(fp, "----------------------------------------\n");
	        fprintf(fp, "【当前收藏夹内容】\n");
	        for(int i = 0; i < favCount; i++){
	            fprintf(fp, "  %d. [%s] %s\n", i+1, favorites[i].type, favorites[i].data);
	        }
	        fprintf(fp, "共收藏 %d 项\n", favCount);
	    }
	    
	    fprintf(fp, "\n========================================\n");
	    fprintf(fp, "         报告生成完毕\n");
	    fprintf(fp, "========================================\n");
	    
	    fclose(fp);
	    printf("\n搜索结果已成功导出到文件：%s\n", fullFilename);
	    printf("文件保存在程序运行目录下\n");
	}
	
